# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# Keep vendored frontend build files needed in production
!static/vendor/bootstrap/
!static/vendor/bootstrap/5.3.3/
!static/vendor/bootstrap/5.3.3/dist/
!static/vendor/bootstrap/5.3.3/dist/css/
!static/vendor/bootstrap/5.3.3/dist/css/bootstrap.min.css
!static/vendor/bootstrap/5.3.3/dist/js/
!static/vendor/bootstrap/5.3.3/dist/js/bootstrap.bundle.min.js

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# pytest
.pytest_cache/
pytest-cache-files-*/
.cache/

# Coverage
.coverage
htmlcov/
coverage.xml

# Outputs (generated at runtime)
outputs/csv/*.csv
outputs/figures/*.png
outputs/reports/*.txt
outputs/reports/*.pdf

# Download/extraction leftovers for local vendor assets
fontawesome.zip
temp_fontawesome/
*.zip

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Flask session / instance
instance/
*.sqlite3

